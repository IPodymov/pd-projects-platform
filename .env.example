# Development only. Generate a unique Fernet key: make key
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=local-development-only-not-for-hosting
DATABASE_URL=postgresql://platform:platform@postgres:5432/platform
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1,api
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
INVITATION_ENCRYPTION_KEY=
S3_BUCKET=documents
S3_ENDPOINT_URL=http://s3:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=locals3
S3_SECRET_KEY=locals3-development-only
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=platform@localhost
API_PROXY_TARGET=http://api:8000
# Empty uses Vite proxy. Public URL only; never secrets.
VITE_API_URL=

# Optional server-only Git integrations. Never expose in VITE_*.
GITHUB_TOKEN=
GITVERSE_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITVERSE_WEBHOOK_SECRET=
