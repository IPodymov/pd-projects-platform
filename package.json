{
  "name": "future-engineers",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "build": "npm run build -w packages/api-client && npm run build -w apps/web",
    "type-check": "npm run type-check -w apps/web",
    "api:generate": "openapi-typescript docs/openapi.yaml -o packages/api-client/src/schema.ts",
    "dev:web": "npm run dev -w apps/web",
    "dev:logs": "docker compose logs --follow api web worker",
    "dev:stop": "docker compose down"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
